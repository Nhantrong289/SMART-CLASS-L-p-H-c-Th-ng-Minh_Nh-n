rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || !exists(/databases/$(database)/documents/users/$(userId)));
      allow delete: if false;
    }

    // Classes collection: Teacher only accesses and modifies their own classes
    // Fields: name (tên lớp), teacherUid (UID giáo viên sở hữu), createdAt (ngày tạo)
    match /classes/{classId} {
      allow list: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
      allow get: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.teacherUid == request.auth.uid && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
    }

    // Students collection: Teacher only accesses and modifies their own students
    // Fields: name (họ tên), classId (mã lớp), teacherUid (UID giáo viên sở hữu), createdAt (ngày tạo)
    match /students/{studentId} {
      allow list: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
      allow get: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.teacherUid == request.auth.uid && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.teacherUid == request.auth.uid;
    }

    // Questions collection
    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthenticated() || request.auth == null;
    }

    // Quizzes collection
    match /quizzes/{quizId} {
      allow get, list: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
